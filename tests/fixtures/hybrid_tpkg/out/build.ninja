# build.ninja - generated by thorn 1.0, do not edit
# project: hybrid_test (deterministic: same graph and environment, same bytes)

ninja_required_version = 1.3

thorn_project = hybrid_test
cc = cc
as = as
ar = ar

rule cc
  command = $cc $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = cc $in

rule as
  command = $as $asflags -c $in -o $out
  description = as $in

rule as_cpp
  command = $cc -MD -MF $out.d $asflags $cflags -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = as_cpp $in

rule link
  command = $cc $in $ldflags -o $out
  description = link $out

rule solink
  command = $cc -shared $in $ldflags -o $out
  description = shared $out

rule ar
  command = rm -f $out && $ar rcs $out $in
  description = ar $out

# custom command 1 (libsafe.a)
rule cmd_1
  command = rustc --edition 2021 --crate-name safe --crate-type staticlib -C panic=abort -C opt-level=z --emit=dep-info=out/libsafe.a.d,link=out/libsafe.a rust/src/lib.rs
  description = rustc --edition 2021 --crate-name safe --crate-type staticlib -C panic=abort -C opt-level=z --emit=dep-info=out/libsafe.a.d,link=out/libsafe.a rust/src/lib.rs

build out/libsafe.a: cmd_1 rust/src/lib.rs

# custom command 2 (.thorn-rs/safe.verified)
rule cmd_2
  command = mkdir -p out/.thorn-rs && for s in probe_answer probe_answer; do nm -g --defined-only out/libsafe.a 2>/dev/null | grep -qw "$$s" || exit 1; done && touch out/.thorn-rs/safe.verified
  description = mkdir -p out/.thorn-rs && for s in probe_answer probe_answer; do nm -g --defined-only out/libsafe.a 2>/dev/null | grep -qw "$$s" || exit 1; done && touch out/.thorn-rs/safe.verified

build out/.thorn-rs/safe.verified: cmd_2 out/libsafe.a

build out/thorn_all: phony out/app
default out/thorn_all

# target app (executable)
build out/app__src_main.o: cc src/main.c || out/.thorn-rs/safe.verified
build out/app: link out/app__src_main.o out/libsafe.a | out/.thorn-rs/safe.verified
build app: phony out/app

